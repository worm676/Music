# Claude API key. Without it, agents run in simulated demo mode.
ANTHROPIC_API_KEY=

# Supabase project (Settings -> API). Without these, tasks live in server memory (demo mode).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# n8n / GoHighLevel webhooks. Any N8N_WEBHOOK_<NAME> becomes a webhook the agents can call as "<name>".
N8N_WEBHOOK_CRM=
N8N_WEBHOOK_EMAIL=

# Optional: require a password (HTTP Basic auth, any username) for the whole app. Set this before deploying publicly.
APP_PASSWORD=
